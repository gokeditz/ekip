<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Ekip.Ortak\Ekip.Ortak.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Varliklar\ekip.ico" LogicalName="ekip.ico" />
    <!-- Renkli emoji: Twemoji PNG'leri + arama verisi (Varliklar\emoji\uret.mjs ile üretilir). -->
    <EmbeddedResource Include="Varliklar\emoji\emoji.zip" LogicalName="emoji.zip" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="11.0.0" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Form tasarımcısı kullanmıyoruz, her şey kodda. -->
    <NoWarn>$(NoWarn);WFO1000</NoWarn>
    <ApplicationIcon>Varliklar\ekip.ico</ApplicationIcon>
    <!-- Sürüm: yayınlarken -p:Version=1.2.3 ile verilir; otomatik güncelleme bunu karşılaştırır. -->
    <Version>1.0.0</Version>
  </PropertyGroup>

</Project>