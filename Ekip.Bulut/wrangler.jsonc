// Ekip sunucusu (Cloudflare). Yayınlamak: npx wrangler deploy
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ekip",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "observability": { "enabled": true },

  // Bütün veri ve anlık bağlantılar tek bir Durable Object'te: içinde SQLite var.
  "durable_objects": {
    "bindings": [{ "name": "EKIP", "class_name": "EkipSunucu" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["EkipSunucu"] }],

  // Dosyalar (fotoğraf, video, ...) R2 kovasında; baytlar Durable Object'e girmez.
  "r2_buckets": [{ "binding": "DOSYALAR", "bucket_name": "ekip-dosyalar" }],

  "vars": {
    // IP başına dakikada giriş/kayıt denemesi.
    "HESAP_LIMITI": "10",
    // GIF sağlayıcısı: giphy | klipy | tenor. Anahtar gizli değişkendir: npx wrangler secret put GIF_ANAHTARI
    "GIF_SAGLAYICI": "giphy"
  }
}
