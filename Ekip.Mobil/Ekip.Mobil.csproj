<Project Sdk="Microsoft.NET.Sdk">

	<!-- Uygulama'nın Android sürümü (.NET MAUI). Android Studio gerekmez:
	     derlemek için   dotnet build Ekip.Mobil -c Release
	     APK için        dotnet publish Ekip.Mobil -c Release   (bkz. Ekip.Mobil/README.md) -->
	<PropertyGroup>
		<TargetFramework>net10.0-android</TargetFramework>
		<OutputType>Exe</OutputType>
		<RootNamespace>Ekip.Mobil</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<MauiXamlInflator>SourceGen</MauiXamlInflator>

		<ApplicationTitle>Uygulama</ApplicationTitle>
		<ApplicationId>com.uygulama.mobil</ApplicationId>
		<ApplicationDisplayVersion>0.1.0</ApplicationDisplayVersion>
		<ApplicationVersion>1</ApplicationVersion>

		<!-- Android 7.0 ve üstü (eski/zayıf telefonlar dahil). -->
		<SupportedOSPlatformVersion>24.0</SupportedOSPlatformVersion>

		<!-- Arkadaşlara doğrudan dağıtılacak tek APK (mağaza paketi değil). -->
		<AndroidPackageFormat>apk</AndroidPackageFormat>

		<!-- Araçların yeri (Android Studio yok): JDK, "InstallAndroidDependencies" ile buraya kuruldu. -->
		<JavaSdkDirectory Condition="'$(JavaSdkDirectory)' == '' and Exists('$(LOCALAPPDATA)\Uygulama-gelistirme\jdk')">$(LOCALAPPDATA)\Uygulama-gelistirme\jdk</JavaSdkDirectory>
		<AndroidSdkDirectory Condition="'$(AndroidSdkDirectory)' == '' and Exists('$(LOCALAPPDATA)\Android\Sdk')">$(LOCALAPPDATA)\Android\Sdk</AndroidSdkDirectory>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\Ekip.Ortak\Ekip.Ortak.csproj" />
		<!-- Masaüstüyle ortak sunucu bağlantı kodu (tek kaynak; kopyalanmaz). -->
		<Compile Include="..\Ekip.Uygulama\Api.cs" Link="Paylasilan\Api.cs" />
		<Compile Include="..\Ekip.Uygulama\Ag.cs" Link="Paylasilan\Ag.cs" />
		<Compile Include="..\Ekip.Uygulama\Canli.cs" Link="Paylasilan\Canli.cs" />
	</ItemGroup>

	<ItemGroup>
		<!-- Simge ve açılış ekranı: masaüstüyle aynı logo (mor zeminde 31'li ev). -->
		<MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.png" Color="#6A4BF0" />
		<MauiSplashScreen Include="Resources\Splash\splash.png" Color="#111214" BaseSize="128,128" />
		<MauiImage Include="Resources\Images\*" />
		<MauiFont Include="Resources\Fonts\*" />
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
		<PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="11.0.0" />
	</ItemGroup>

</Project>
